# Dependencies
node_modules/
**/node_modules/

# Build outputs: the workstation's compiled tree is ~187 MB and is rebuilt by build.ps1
bin/
obj/
workstation/src/**/bin/
workstation/src/**/obj/
*.user
*.suo
.vs/

# Local data: the workstation keeps an isolated library whose records hold real paths from this machine
workstation/data/

# Packaging artefacts
*.tgz
*.nupkg

# Scratch and backups
*.bak
*.bak-*
*.tmp
kohane-stage.wav

# Reverse-engineering evidence: the FL work produced both design conclusions and per-format internals,
# and the samples folder is 165 MB of third-party material. Neither belongs in a public repository.
# The design documents (research/notes) are kept, since the architecture cites them.
research/

# Machine-local format knowledge: the engine loads it if present, and it is never published (recovered from this machine's own files, so it is not part of the product).
deps/local/

# Downloaded or borrowed tools: recorded in deps/manifest.json, never committed
deps/downloads/

# The local task list names in-flight reverse-engineering work; the published tree carries the
# engine, the checks, the shell and the art, not the evidence chain behind them.
TODO.md

# Unity's generated tree: hundreds of megabytes of import cache, and package payloads that exceed a
# forge's file size limit. The project is a folder of scripts plus ProjectSettings, and Unity rebuilds
# everything under here on first open.
workstation-unity/Library/
workstation-unity/Temp/
workstation-unity/obj/
workstation-unity/Build/
workstation-unity/build/
workstation-unity/Logs/
workstation-unity/UserSettings/
